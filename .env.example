# =====================================================================
# SUPERNOVA 2026 - Environment Configuration Template
# =====================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Admin Access Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Supabase PostgreSQL Database (Production on Render)
# Format: postgresql://postgres.[project_ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email Delivery Configuration (Choose Option A or Option B)
# Option A: HTTP Email API (Recommended for Render Free Tier - Port 443 HTTPS, never blocked)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BREVO_API_KEY=

# Option B: Standard SMTP Relay (For Local Dev or Render Paid/Starter Instances with Port 587 open)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SUPERNOVA
SMTP_USE_TLS=true
SMTP_USE_SSL=false
